{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ILC Flow Validator",
  "version": "0.1.7",
  "identifier": "com.russus.ilcvalidator",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Validatore Flusso Unicredit ILC",
        "width": 1120,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "app", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Valida un file del flusso Unicredit ILC e ne mostra l'anteprima",
    "longDescription": "Strumento offline per controllare un file di input del flusso Unicredit ILCM01 prima della lavorazione e vedere l'anteprima di come verrà tradotto nei file BOL, cust_data.xml e DAT.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {}
}
